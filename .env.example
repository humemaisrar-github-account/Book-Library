# Supabase -> Project Settings -> API (or the "Connect" dialog on the project home)
# Either naming works; the app accepts both.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Supabase's own Next.js quickstart uses these names instead:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
