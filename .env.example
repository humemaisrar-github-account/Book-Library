# ---------------------------------------------------------------------------
# Database — Supabase -> Connect -> ORMs/Direct -> "Transaction pooler" URI.
# Use the POOLER string (port 6543) on Vercel; a direct connection runs out of
# slots. Replace [YOUR-PASSWORD] with your database password.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Better Auth — generate the secret with: openssl rand -base64 32
# BETTER_AUTH_URL is the public URL of the site (no trailing slash).
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=a-long-random-string-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google sign-in (optional). Leave both out and the app uses email and
# password only — the Google button simply does not appear.
# Authorised redirect URI in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
