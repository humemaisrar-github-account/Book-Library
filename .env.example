# ---------------------------------------------------------------------------
# Database — Supabase -> Connect -> Connection string -> Transaction pooler.
# Use the POOLER string (port 6543) on Vercel; a direct connection runs out of
# slots. Replace [YOUR-PASSWORD] with your database password.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Accounts — Clerk dashboard -> API keys.
# The secret key is shown once, so save it when you create it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
